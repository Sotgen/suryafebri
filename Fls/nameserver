#!/bin/bash
# Fls/nameserver -- pemasang SlowDNS (paket slowdns-linux-amd64.tar.gz dari repo ini).
# Versi perbaikan: default domain NS = dns.suryates.alwaristore.biz.id
# (bisa diganti lewat variabel SLOWDNS_DEFAULT_NS atau diketik manual di prompt).
Green="\e[92;1m"
RED="\033[1;31m"
YELLOW="\033[33m"
BLUE="\033[36m"
FONT="\033[0m"
REDBG="\033[41;37m"
green='\e[0;32m'
ERROR="${RED}[ERROR]${FONT}"
REPO="https://raw.githubusercontent.com/Sotgen/suryafebri/main/"

if [ "${EUID}" -ne 0 ]; then
echo "Jalankan sebagai root"
exit 1
fi

print_install() {
echo -e "${green} =============================== ${FONT}"
echo -e "${YELLOW} # $1 ${FONT}"
echo -e "${green} =============================== ${FONT}"
sleep 1
}
print_error() {
echo -e "${ERROR} ${REDBG} $1 ${FONT}"
}
print_success() {
if [[ 0 -eq $? ]]; then
echo -e "${green} =============================== ${FONT}"
echo -e "${Green} # $1 berhasil dipasang"
echo -e "${green} =============================== ${FONT}"
sleep 2
fi
}

function ssh_slow(){
clear
print_install "Memasang SlowDNS Server"

# ================= PENGATURAN (ubah di sini) =================
: "${SLOWDNS_URL:=${REPO}slowdns-linux-amd64.tar.gz}"
: "${SLOWDNS_SHA256:=6aa42455cd142953270a342e3c24c9c946fdc4ef3cad1e5c02f27711ffc6ad41}"
: "${SLOWDNS_DIR:=/root/slowdns}"
: "${SLOWDNS_UPSTREAM:=127.0.0.1:22}"
# Domain NS default (tekan Enter di prompt untuk memakainya)
: "${SLOWDNS_DEFAULT_NS:=dns.suryates.alwaristore.biz.id}"
# 1 = pakai ulang key lama, 0 = buat key baru (pubkey berubah)
: "${SLOWDNS_KEEP_OLD_KEY:=1}"
# =============================================================

local ns_old ns_domain ns_main ns_sugg lip f svc ganti
ns_old=$(cat /etc/xray/dns 2>/dev/null)
ns_domain=""
ns_main=$(cat /etc/xray/domain 2>/dev/null)
echo -e ""
echo -e "${YELLOW}----------------------------------------------${FONT}"
echo -e "              DOMAIN NS SLOWDNS"
echo -e "${YELLOW}----------------------------------------------${FONT}"
if [[ -n $ns_old ]]; then
echo -e " Domain NS saat ini : $ns_old"
read -p " Ganti domain NS? [y/N] : " ganti
if [[ $ganti != "y" && $ganti != "Y" ]]; then
ns_domain=$ns_old
fi
fi
if [[ -z $ns_domain ]]; then
ns_sugg="$SLOWDNS_DEFAULT_NS"
echo -e " Domain utama : ${ns_main:-belum diisi}"
echo -e " Tekan Enter untuk memakai default NS: $ns_sugg"
while true; do
read -p " Masukkan domain NS [${ns_sugg}] : " ns_domain
ns_domain=${ns_domain:-$ns_sugg}
ns_domain=${ns_domain,,}
if [[ -n $ns_main && $ns_domain == "$ns_main" ]]; then
print_error "Domain NS tidak boleh sama dengan domain utama ($ns_main). Pakai domain NS khusus SlowDNS."
continue
fi
if [[ $ns_domain =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$ ]]; then
break
fi
print_error "Domain tidak valid, coba lagi"
done
fi
echo -e " Domain NS dipakai  : $ns_domain"

lip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
if [[ -z $lip ]]; then
print_error "IP VPS tidak terdeteksi"
return 1
fi

# --- Hapus instalasi SlowDNS lama ---
for svc in server client; do
f=/etc/systemd/system/$svc.service
if [ -f "$f" ] && grep -qE "dnstt|slowdns" "$f"; then
systemctl disable --now $svc >/dev/null 2>&1
rm -f "$f"
fi
done
if [ -f /etc/systemd/system/slowdns.service ]; then
systemctl stop slowdns >/dev/null 2>&1
# amankan key lama sebelum uninstall
if [ "$SLOWDNS_KEEP_OLD_KEY" = "1" ] && [ -s "$SLOWDNS_DIR/server.key" ] && [ -s "$SLOWDNS_DIR/server.pub" ]; then
mkdir -p /etc/slowdns
install -m 0600 "$SLOWDNS_DIR/server.key" /etc/slowdns/server.key
install -m 0644 "$SLOWDNS_DIR/server.pub" /etc/slowdns/server.pub
fi
[ -f "$SLOWDNS_DIR/install.sh" ] && bash "$SLOWDNS_DIR/install.sh" uninstall >/dev/null 2>&1
rm -f "$SLOWDNS_DIR/slowdns.env"
fi
while iptables -t nat -D PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300 2>/dev/null; do :; done
sed -i '/--to-ports 5300/d;/--dport 5300/d' /etc/rc.local 2>/dev/null
systemctl daemon-reload

mkdir -p "$SLOWDNS_DIR"
if [ "$SLOWDNS_KEEP_OLD_KEY" = "1" ] && [ -s /etc/slowdns/server.key ] && [ -s /etc/slowdns/server.pub ] && [ ! -s "$SLOWDNS_DIR/server.key" ]; then
install -m 0600 /etc/slowdns/server.key "$SLOWDNS_DIR/server.key"
install -m 0644 /etc/slowdns/server.pub "$SLOWDNS_DIR/server.pub"
fi
rm -rf /etc/slowdns

# --- Unduh, cek keaslian, ekstrak ---
wget -q -O /tmp/slowdns.tar.gz "$SLOWDNS_URL"
if [ ! -s /tmp/slowdns.tar.gz ]; then
print_error "Gagal mengunduh SlowDNS dari $SLOWDNS_URL"
return 1
fi
if [ -n "$SLOWDNS_SHA256" ] && ! echo "$SLOWDNS_SHA256  /tmp/slowdns.tar.gz" | sha256sum -c --quiet - >/dev/null 2>&1; then
print_error "SHA256 file SlowDNS tidak cocok, instalasi dibatalkan"
rm -f /tmp/slowdns.tar.gz
return 1
fi
tar -xzf /tmp/slowdns.tar.gz -C "$SLOWDNS_DIR" slowdns install.sh
rm -f /tmp/slowdns.tar.gz
chown root:root "$SLOWDNS_DIR" "$SLOWDNS_DIR/slowdns" "$SLOWDNS_DIR/install.sh"
chmod 755 "$SLOWDNS_DIR" "$SLOWDNS_DIR/slowdns" "$SLOWDNS_DIR/install.sh"

# --- Installer otomatis: IP, port, domain, tujuan ---
if ! printf '%s\n%s\n%s\n%s\n' "$lip" 53 "$ns_domain" "$SLOWDNS_UPSTREAM" | bash "$SLOWDNS_DIR/install.sh" install > /root/slowdns-install.log 2>&1; then
cat /root/slowdns-install.log
print_error "Instalasi SlowDNS gagal (log: /root/slowdns-install.log)"
return 1
fi

# --- Verifikasi: domain di slowdns.env harus sama dengan yang dipilih ---
if [ -f "$SLOWDNS_DIR/slowdns.env" ]; then
sed -i "s|^SLOWDNS_DOMAIN=.*|SLOWDNS_DOMAIN=\"${ns_domain}\"|" "$SLOWDNS_DIR/slowdns.env"
systemctl daemon-reload
systemctl restart slowdns
fi

# --- Kompatibilitas dengan menu/skrip lama ---
mkdir -p /etc/xray /etc/slowdns
echo "$ns_domain" > /etc/xray/dns
[ -f "$SLOWDNS_DIR/server.pub" ] && install -m 0644 "$SLOWDNS_DIR/server.pub" /etc/slowdns/server.pub
[ -f "$SLOWDNS_DIR/server.key" ] && install -m 0600 "$SLOWDNS_DIR/server.key" /etc/slowdns/server.key

clear
echo -e "${YELLOW}----------------------------------------------${FONT}"
echo -e " NS Domain  : $ns_domain"
echo -e " Public Key : $(cat $SLOWDNS_DIR/server.pub)"
echo -e " Port       : UDP 53  (buka di firewall VPS & panel provider)"
echo -e " Record DNS : A   ns.<domain>  ->  $lip   (DNS only, bukan proxied)"
echo -e "              NS  $ns_domain  ->  ns.<domain>"
echo -e "${YELLOW}----------------------------------------------${FONT}"
echo -e " Cek domain aktif:"
ps aux | grep "[s]lowdns -udp" | awk '{print "   " $NF " <- " $(NF-1)}'
sleep 3
print_success "SlowDNS"
}

ssh_slow
